{
  "name": "@startica/desktop",
  "productName": "Startica",
  "version": "0.0.7",
  "private": true,
  "license": "MIT",
  "description": "Startica: the open-source startup harness",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "echo \"(plain JS)\"",
    "lint": "echo \"(no lint config yet)\"",
    "test": "node --test \"posting/*.test.mjs\" \"loading/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "icons": "node scripts/icons.mjs",
    "build": "node scripts/build.mjs",
    "splash": "node scripts/splash.mjs"
  },
  "devDependencies": {
    "@startica/brand": "workspace:^",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.mystartica.desktop",
    "productName": "Startica",
    "copyright": "Copyright © 2026 Christopher Casper",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.mjs",
      "updater.mjs",
      "about/*",
      "posting/*",
      "scanner/*",
      "renderer/*",
      "loading/splash.html",
      "package.json",
      "assets/*.png"
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": false,
      "signIgnore": [
        "/Contents/Resources/server/"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "executableName": "startica",
      "maintainer": "Startica <hello@mystartica.com>"
    },
    "deb": {
      "artifactName": "startica_${version}_${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "chriscasper",
        "repo": "startica",
        "releaseType": "draft"
      }
    ]
  },
  "homepage": "https://mystartica.com",
  "author": {
    "name": "Startica",
    "email": "hello@mystartica.com"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
