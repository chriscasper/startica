{% import "partials/icons.njk" as icon %}
<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur supports-[backdrop-filter]:bg-bg/75">
  <div class="mx-auto flex h-16 max-w-[90rem] items-center gap-3 px-4 sm:px-6">
    <button type="button" class="-ml-1 p-2 text-muted hover:text-fg lg:hidden" data-nav-toggle aria-controls="docs-nav" aria-expanded="false" aria-label="Open navigation">
      {{ icon.menu() }}
    </button>
    <a href="/" class="flex items-center gap-2" aria-label="Startica docs home">
      <span class="brand-logo h-5">{{ site.logo | safe }}</span>
      <span class="font-display text-sm font-semibold text-accent">Docs</span>
    </a>

    <button type="button" data-search-open class="ml-auto flex h-9 w-full max-w-64 items-center gap-2 border border-line bg-surface px-3 text-sm text-muted hover:border-fg/30 md:ml-8 md:max-w-80" aria-label="Search the docs">
      {{ icon.search() }}
      <span class="flex-1 text-left">Search</span>
      <kbd class="hidden font-mono text-xs sm:inline" data-search-kbd>⌘K</kbd>
    </button>

    <nav class="ml-auto hidden items-center gap-5 text-sm font-semibold text-muted md:flex" aria-label="Site">
      <a href="{{ site.homepage }}" class="hover:text-fg">mystartica.com</a>
      <a href="{{ site.repo }}" class="flex items-center gap-1.5 hover:text-fg" aria-label="Startica on GitHub">{{ icon.github() }}<span class="hidden xl:inline">GitHub</span></a>
    </nav>
    <button type="button" class="theme-toggle p-2 text-muted hover:text-fg max-md:ml-1" data-theme-toggle aria-label="Toggle dark mode">
      {{ icon.moon() }}{{ icon.sun() }}
    </button>
  </div>
</header>
