{% import "partials/icons.njk" as icon %}
<footer class="border-t border-line bg-surface">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 text-sm md:grid-cols-[1.4fr_1fr_1fr_1fr] md:px-8">
    <div>
      <a href="/" class="brand-logo h-5" aria-label="Startica home">{{ site.logo | safe }}</a>
      <p class="mt-3 max-w-xs leading-relaxed text-muted">The open-source startup harness. It runs on your desktop, and you approve every move.</p>
      <a href="{{ site.repo }}" class="mt-5 inline-flex items-center gap-2 font-semibold text-muted hover:text-fg">{{ icon.github() }} chriscasper/startica</a>
    </div>
    <div>
      <p class="font-display text-xs font-bold uppercase tracking-[0.14em]">Product</p>
      <ul class="mt-4 space-y-2.5 text-muted">
        <li><a class="hover:text-fg" href="/marketing">Marketing</a></li>
        <li><a class="hover:text-fg" href="/seo">SEO &amp; GEO</a></li>
        <li><a class="hover:text-fg" href="/accessibility">Accessibility</a></li>
        <li><a class="hover:text-fg" href="/security">Security</a></li>
        <li><a class="hover:text-fg" href="/download">Download</a></li>
        <li><a class="hover:text-fg" href="/get-started">Get started</a></li>
        <li><a class="hover:text-fg" href="/roadmap">Roadmap</a></li>
        <li><a class="hover:text-fg" href="/changelog">Changelog</a></li>
      </ul>
    </div>
    <div>
      <p class="font-display text-xs font-bold uppercase tracking-[0.14em]">Docs</p>
      <ul class="mt-4 space-y-2.5 text-muted">
        <li><a class="hover:text-fg" href="{{ site.docs }}/getting-started/install">Install</a></li>
        <li><a class="hover:text-fg" href="{{ site.docs }}/credentials">Credentials</a></li>
        <li><a class="hover:text-fg" href="{{ site.docs }}/troubleshooting">Troubleshooting</a></li>
        <li><a class="hover:text-fg" href="{{ site.docs }}/contributing">Contributing</a></li>
      </ul>
    </div>
    <div>
      <p class="font-display text-xs font-bold uppercase tracking-[0.14em]">Project</p>
      <ul class="mt-4 space-y-2.5 text-muted">
        <li><a class="hover:text-fg" href="/community">Community</a></li>
        <li><a class="hover:text-fg" href="/privacy">Privacy</a></li>
        <li><a class="hover:text-fg" href="/brand">Brand</a></li>
        <li><a class="hover:text-fg" href="{{ site.repo }}/blob/main/SECURITY.md">Security</a></li>
        <li><a class="hover:text-fg" href="mailto:{{ site.email }}">{{ site.email }}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="mx-auto max-w-6xl px-6 py-6 text-xs text-muted md:px-8">© {{ "now" | date("yyyy") }} Christopher Casper. Startica is free software under the <a class="underline underline-offset-2 hover:text-fg" href="{{ site.repo }}/blob/main/LICENSE">MIT License</a>.</p>
  </div>
</footer>
