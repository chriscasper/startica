{
  "name": "@startica/web",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "Startica marketing site — mystartica.com",
  "type": "module",
  "scripts": {
    "dev": "node scripts/changelog.mjs && simple dev",
